# ClaimVision PostgreSQL Configuration
# Canonical database: PostgreSQL 16 via Docker Compose
# Run: docker compose up -d  before executing the pipeline

# Option 1: Full DATABASE_URL (preferred)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/claimvision_db

# Option 2: Individual parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claimvision_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Pipeline Settings
LOG_LEVEL=INFO
RANDOM_SEED=42
CLASSIFICATION_THRESHOLD=0.7729

# Database Configuration
# Default is zero-setup SQLite database at data/processed/claimvision.db
DB_DIALECT=sqlite
DB_PATH=data/processed/claimvision.db

# Optional PostgreSQL configuration
# DB_DIALECT=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=claimvision_db
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Pipeline Settings
LOG_LEVEL=INFO
RANDOM_SEED=42
SAMPLE_SIZE=5000
CLASSIFICATION_THRESHOLD=0.35
